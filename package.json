{
  "name": "dnd_player",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev -w @dnd/api\" \"npm run dev -w @dnd/web\"",
    "db:prepara": "npm run db:prepara -w @dnd/api",
    "build": "tsc -b && npm run build -w @dnd/web && npm run build -w @dnd/api",
    "lint": "eslint .",
    "preview": "npm run preview -w @dnd/web",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.13.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
